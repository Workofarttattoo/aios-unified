# ──────────────────────────────────────────────────────────────────────
# Ai:oS Unified — Environment Variables
# ──────────────────────────────────────────────────────────────────────
# Copy to .env and fill in real values.  Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────

# ── General ─────────────────────────────────────────────────────────
LOG_LEVEL=info                         # debug | info | warning | error
LOG_FORMAT=json                        # json | text
PORT=8080                              # HTTP listen port
ALLOW_NETWORK_CALLS=false              # enable outbound HTTP from agents

# ── USPTO (Patent API) ─────────────────────────────────────────────
USPTO_BASE_URL=https://patentcenter.uspto.gov/api
USPTO_TIMEOUT=30
USPTO_USERNAME=
USPTO_PASSWORD=
USPTO_API_KEY=

# ── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

# ── Observability ───────────────────────────────────────────────────
SENTRY_DSN=

# ── LLM Providers (used by model_router & agents) ──────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Cloud Providers (optional — for scalability agent) ──────────────
AGENTA_PROVIDER=                       # docker | aws | gcp | azure | qemu | libvirt
AGENTA_AWS_REGION=us-west-2
AGENTA_AZURE_SUBSCRIPTION=
AGENTA_GCP_PROJECT=
AGENTA_GCP_ZONE=

# ── Virtualization (optional) ──────────────────────────────────────
AGENTA_QEMU_IMAGE=
AGENTA_QEMU_EXECUTE=0                 # 1 to actually start guests
AGENTA_QEMU_HEADLESS=1
AGENTA_LIBVIRT_DOMAIN=
AGENTA_LIBVIRT_EXECUTE=0

# ── Security Toolkit (optional) ────────────────────────────────────
AGENTA_SECURITY_TOOLS=                 # comma-separated: AuroraScan,CipherSpear,...

# ── Docker Socket (optional) ───────────────────────────────────────
DOCKER_SOCKET=/var/run/docker.sock
